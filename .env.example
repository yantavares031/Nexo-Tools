# Copie para `.env` e ajuste os valores.

# -----------------------------------------------------------------------------
# Logs estruturados (Pino — JSON por linha em arquivo + cópia em stdout)
# -----------------------------------------------------------------------------
# Caminho do arquivo de log (absoluto ou relativo ao cwd do processo).
# Padrão se omitido: `{cwd}/logs/app.log`
# Docker (volume montado): ex. LOG_PATH=/app/logs/app.log
# LOG_PATH=logs/app.log
# A tela "Logs do sistema" (admin) lê até 32 MB do fim deste arquivo por requisição.

# Opcional — nível MÍNIMO do Pino (tudo deste nível para CIMA vai para o arquivo):
# trace < debug < info < warn < error < fatal
# Sem LOG_LEVEL o app usa "info": grava info, warn, error e fatal (erros não são suprimidos).
# Só use LOG_LEVEL se quiser mais verbosidade (debug/trace) ou menos (warn/error) em algum ambiente.
# LOG_LEVEL=trace

# -----------------------------------------------------------------------------
# Cloudflare R2 (anexos, backup com ACTIVE_PROVIDER_BACKUP=R2, foto de perfil em avatars/)
# -----------------------------------------------------------------------------
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# Migração aditiva (coluna avatarKey em users), uma vez em produção:
# npm run db:migrate -- migrate-users-avatar-key

# -----------------------------------------------------------------------------
# Deploy local (`npm run deploy:all`) — não commitar valores reais
# -----------------------------------------------------------------------------
# DEPLOY_SSH_PASSWORD=
# DOCKERHUB_TOKEN=
# Opcional — usuário Docker Hub (padrão yantavares021)
# DOCKERHUB_USERNAME=

# -----------------------------------------------------------------------------
# Banco / app (exemplos — ver documentação do projeto)
# -----------------------------------------------------------------------------
# DATABASE_URL=
# ...
