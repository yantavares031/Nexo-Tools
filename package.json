{
  "name": "nexo_tools",
  "version": "1.0.11",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "tsx DB/seed.ts",
    "db:seed-centros-custo": "tsx DB/seed-centros-custo.ts",
    "db:update-demandas-mes": "tsx DB/update-demandas-mes.ts",
    "db:prepare": "tsx scripts/db-prepare.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:init-postgres": "tsx scripts/db-init-postgres.ts",
    "backup": "tsx scripts/backup.ts",
    "docker:push": "docker buildx build --platform linux/amd64 -t yantavares021/nexo-tools:latest --push .",
    "docker:build": "docker buildx build --platform linux/amd64 -t yantavares021/nexo-tools:latest --load .",
    "docker:push-only": "docker push yantavares021/nexo-tools:latest",
    "version:bump": "npm version patch --no-git-tag-version",
    "github:push": "git add . && git commit -m \"update\" && git push origin main",
    "deploy:all": "tsx scripts/deploy-all.ts",
    "deploy:ssh": "tsx scripts/deploy-all.ts --ssh-only",
    "tunnel:db": "ssh -N -o ServerAliveInterval=30 -o ServerAliveCountMax=999 -o TCPKeepAlive=yes -L 127.0.0.1:4420:127.0.0.1:4420 yan@nexo.sebraelinks.com"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1014.0",
    "better-sqlite3": "^12.6.2",
    "dotenv": "^17.3.1",
    "lucide-react": "^0.563.0",
    "mammoth": "^1.12.0",
    "next": "16.1.6",
    "nodemailer": "^8.0.4",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
